# 本課統一使用 Ollama Cloud 的 Gemma 4。先執行：ollama run gemma4:cloud 並完成登入。
LLM_MODEL=gemma4:cloud
OLLAMA_BASE_URL=http://localhost:11434

# Create a GitHub fine-grained PAT with read-only access to the repository you will review.
# 到 https://github.com/settings/personal-access-tokens 建立 fine-grained PAT；只選目標 repo，並開啟 Contents、Pull requests、Issues、Actions、Commit statuses 的 Read-only。
GITHUB_TOKEN=github_pat_replace_me

# GitHub's official, externally hosted MCP Server in strict read-only mode.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
